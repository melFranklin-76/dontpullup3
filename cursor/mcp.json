{
  "mcpServers": {
    "taskmaster-ai": {
      "command": "npx",
      "args": ["-y", "--package=task-master-ai", "task-master-ai"],
      "env": {
        "ANTHROPIC_API_KEY": "sk-ant-api03-...",
        "PERPLEXITY_API_KEY": "YOUR_PERPLEXITY_API_KEY_OPTIONAL"
      }
    }
  },
  "tools": [
    {
      "name": "Swift Async/Await Compliance",
      "glob": "**/*.swift",
      "command": "swiftlint lint --config .cursor/swiftlint_async.yml"
    },
    {
      "name": "Video Metadata Validator",
      "glob": "**/*.swift",
      "command": "python3 .cursor/video_metadata_check.py"
    }
  ]
}
